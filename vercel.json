{
  "devCommand": "vite",
  "rewrites": [
    {
      "source": "/api/fastapi/:path*",
      "destination": "http://210.246.215.95:8000/:path*"
    },
    {
      "source": "/((?!api/|static/|@vite/|@react-refresh|node_modules/|src/|.*\\..*).*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-high-risk",
      "schedule": "0 8 * * *"
    }
  ]
}